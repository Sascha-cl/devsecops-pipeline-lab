# Scan-Ergebnisse werden als CI-Artefakte veröffentlicht, nicht eingecheckt.
# Grund steht im README unter "Warum die Reports nicht im Repo liegen".
reports/
__pycache__/
*.py[cod]
*.sarif
zap-*.json
zap-*.html
zap-*.md
trivy-report.json
dependency-check-report.*

# Quellcode des Scan-Ziels. Wird in der CI frisch geklont und gehört
# nicht in dieses Repo, sonst läge hier fremder Code unter fremder Lizenz.
target-src/

# Build- und Abhängigkeitsverzeichnisse
node_modules/
target/
dist/
build/
*.tar

# Lokale Umgebung und Zugangsdaten
.env
.env.*
!.env.example
*.key
*.pem
id_rsa*
known_hosts

# IDE und Betriebssystem
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini
